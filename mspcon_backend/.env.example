# ==============================================================================
# MSP Engineering Consultant - Backend Environment Variables Configuration
# ==============================================================================

# Django Secret Key (Generate a strong unique random secret key for production)
SECRET_KEY=django-insecure-change-this-to-a-secure-random-key-in-production

# Debug Mode: Set to True for development, False for production
DEBUG=True

# Allowed Hosts: Comma-separated list of hostnames or IP addresses
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Engine: 'postgres' for production or 'sqlite' for local development
DB_ENGINE=postgres
DB_NAME=mspcon_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_HOST=localhost
DB_PORT=5432

# CORS Allowed Origins: Comma-separated list of authorized frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP / Email Notification Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_smtp_username@domain.com
EMAIL_HOST_PASSWORD=your_smtp_app_password
DEFAULT_FROM_EMAIL=MSP Engineering Consultant <no-reply@mspcon.in>
ENQUIRY_NOTIFICATION_EMAIL=marketing@mspcon.in

# Rate Limiting: Enable or disable rate limiting
RATELIMIT_ENABLE=True
